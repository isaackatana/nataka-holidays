# Supabase project credentials (public/anon key only — never the service_role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp business number used to build wa.me links (international format, no +)
VITE_WHATSAPP_NUMBER=254700000000

# The real production domain (no trailing slash). Only used server-side —
# by scripts/generate-sitemap.mjs (to build sitemap.xml URLs) and
# api/prerender.js (to build canonical/OG URLs for social link previews).
# The browser-side app doesn't need this; it reads window.location.origin
# instead (see src/utils/siteUrl.ts). Not required for local dev.
SITE_URL=https://natakaholidays.co.ke

# ---- M-Pesa (Safaricom Daraja STK Push) — SERVER-SIDE ONLY, set in Vercel ----
# Never prefix these with VITE_ (that would ship them to every visitor's browser).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=...
MPESA_CONSUMER_SECRET=...
MPESA_SHORTCODE=...
MPESA_PASSKEY=...
# Long random string. Must ALSO be stored in the database — see DEPLOYMENT.md §6.
MPESA_CALLBACK_SECRET=...
# Only if you use a Till number (Buy Goods): set TRANSACTION_TYPE=CustomerBuyGoodsOnline
# and MPESA_PARTY_B to the till number.
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_PARTY_B=...
